{
  "schema_version": "ves-pack/1",
  "id": "core-tool-use",
  "version": "1.0.0",
  "released": "2026-11-07",
  "title": "Core tool use",
  "purpose": "The agent picks the right tool with the right args, uses results faithfully, recovers from tool errors and does not claim success it did not achieve.",
