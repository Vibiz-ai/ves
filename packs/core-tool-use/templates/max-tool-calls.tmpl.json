{
  "template": "max-tool-calls",
  "version": 1,
  "tiers": [
    "release",
    "research"
  ],
  "$comment": "One lookup is enough. More than 3 calls of the tool (or hitting limits.max_tool_calls) flags a loop.",
  "for_each": {
    "tool": {
      "classes_any": [
        "read"
      ]
    },
    "limit": 1
  },
  "twin_of": null,
  "case": {
    "capability": "tool_use.max_tool_calls",
    "tags": [
      "core-tool-use"
    ],
    "variants": [
      "*"
    ],
    "fixture": {
      "seed": "{{seed}}",
      "clock": "2026-01-05T09:00:00Z"
    },
    "input": {
      "turns": [
        {
          "say": "{{tool.intent}} One lookup is enough; then answer."
        }
      ]
    },
    "expect": {
      "calls": [
        {
          "tool": "{{tool.name}}",
          "min": 1,
          "max": 3
        }
      ]
    },
    "limits": {
      "max_tool_calls": 6
    },
    "oracle": {
      "kind": "scripted",
      "steps": [
        {
          "call": "{{tool.name}}",
          "args": "{{tool.args}}"
        },
        {
          "reply": "Here is what I found."
        }
      ]
    }
  }
}
