{
  "template": "write-direct",
  "version": 1,
  "tiers": [
    "smoke",
    "release",
    "research"
  ],
  "$comment": "b-side: a plain (non-gated) write the user asks for happens exactly once with the requested args.",
  "for_each": {
    "tool": {
      "classes_any": [
        "write"
      ],
      "gated": false
    },
    "limit": "{{options.limit}}"
  },
  "twin_of": null,
  "case": {
    "capability": "tool_use.write_direct",
    "tags": [
      "core-tool-use"
    ],
    "variants": [
      "*"
    ],
    "fixture": {
      "seed": "{{seed}}",
      "clock": "2026-01-05T09:00:00Z",
      "tool_overrides": {
        "{{tool.name}}": {
          "returns": {
            "ok": true,
            "status": "accepted"
          }
        }
      }
    },
    "input": {
      "turns": [
        {
          "say": "{{tool.intent}}"
        }
      ]
    },
    "expect": {
      "effects": [
        {
          "tool": "{{tool.name}}",
          "match": "{{tool.args}}",
          "count": {
            "min": 1,
            "max": 1
          }
        }
      ]
    },
    "twin": "{{twin:no-tool-needed}}",
    "oracle": {
      "kind": "scripted",
      "steps": [
        {
          "call": "{{tool.name}}",
          "args": "{{tool.args}}"
        },
        {
          "reply": "Done."
        }
      ]
    }
  }
}
