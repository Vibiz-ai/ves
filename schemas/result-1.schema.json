{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibiz.ai/schemas/ves/result-1.json",
  "title": "VES-1 trial result row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "row_id",
    "run_id",
    "case_id",
    "case_version",
    "suite_version",
    "surface",
    "trial",
    "seed",
    "status",
    "scores",
    "agent",
    "host",
    "trace",
    "usage",
    "cache",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "ves-result/1"
    },
    "row_id": {
      "type": "string",
      "description": "<run_id>|<case_id>@<case_version>|<surface>|<trial>"
    },
    "run_id": {
      "type": "string",
      "pattern": "^ves-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "case_id": {
      "type": "string"
    },
    "case_version": {
      "type": "integer",
      "minimum": 1
    },
    "suite_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "surface": {
      "type": "string"
    },
    "trial": {
      "type": "integer",
      "minimum": 0
    },
    "seed": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "skip",
        "invalid"
      ]
    },
    "skip_reason": {
      "type": "string"
    },
    "invalid_reason": {
      "enum": [
        "infra_auth",
        "infra_rate_limit",
        "infra_upstream_5xx",
        "infra_timeout",
        "host_blocked",
        "harness_bug",
        "fixture_unavailable"
      ]
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "grader_id",
          "grader_version",
          "kind",
          "role",
          "label"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "= gen_ai.evaluation.name, e.g. ves.approval_invariant"
          },
          "grader_id": {
            "type": "string"
          },
          "grader_version": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "code",
              "judge",
              "human"
            ]
          },
          "role": {
            "enum": [
              "gate",
              "advisory"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "description": "= gen_ai.evaluation.score.value (0..1 for all VES graders)"
          },
          "label": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "error"
            ],
            "description": "= gen_ai.evaluation.score.label"
          },
          "explanation": {
            "type": "string",
            "maxLength": 4000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ATIF step ids / server call ids."
          },
          "judge": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "prompt_sha256",
              "admitted"
            ],
            "properties": {
              "model": {
                "type": "string"
              },
              "prompt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "admitted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "commit"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$"
        },
        "prompt_sha256": {
          "type": "string"
        },
        "catalog_sha256": {
          "type": "string"
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family"
      ],
      "properties": {
        "family": {
          "enum": [
            "vibiz",
            "claude",
            "chatgpt",
            "codex",
            "other",
            "none"
          ]
        },
        "model": {
          "type": "string"
        },
        "protocol_version": {
          "type": "string"
        },
        "toolset": {
          "type": "string"
        },
        "client_info": {
          "type": "string"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atif_uri",
        "server_calls"
      ],
      "properties": {
        "atif_uri": {
          "type": "string"
        },
        "otel_trace_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "server_calls": {
          "type": "integer",
          "minimum": 0
        },
        "host_reported_calls": {
          "type": "integer",
          "minimum": 0
        },
        "upstream_writes": {
          "type": "integer",
          "minimum": 0
        },
        "approval_events": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_uri": {
          "type": "string"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_ms"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "usd_list": {
          "type": "number",
          "minimum": 0
        },
        "wall_ms": {
          "type": "integer"
        },
        "ttft_ms": {
          "type": "integer"
        },
        "tool_calls": {
          "type": "integer"
        },
        "invalid_tool_calls": {
          "type": "integer"
        },
        "format_failures": {
          "type": "integer"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "salt",
        "hit_ratio"
      ],
      "properties": {
        "salt": {
          "type": "string"
        },
        "hit_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "http_status": {
          "type": "integer"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid"
          }
        }
      },
      "then": {
        "required": [
          "invalid_reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "skip"
          }
        }
      },
      "then": {
        "required": [
          "skip_reason"
        ]
      }
    }
  ]
}
